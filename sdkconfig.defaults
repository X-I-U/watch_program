CONFIG_LV_USE_DEMO_WIDGETS=y
CONFIG_LV_MEM_SIZE_KILOBYTES=48
CONFIG_LV_COLOR_16_SWAP=y
# WiFi/NTP firmware ~1.6MB; use custom partition table with 4M factory app
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
# ADF 2.x components use legacy FreeRTOS names (xSemaphoreHandle etc.); must be enabled
CONFIG_FREERTOS_ENABLE_BACKWARD_COMPATIBILITY=y
# 小智服务器 api.tenclass.net 证书链: leaf -> GeoTrust G2 TLS CN RSA4096 SHA256 2022 CA1(中间) -> DigiCert Global Root G2(根)
# ESP-IDF 默认 bundle 只含根证书, 中间证书不在内 -> esp_crt_bundle 校验 leaf 时 "No matching trusted root"(mbedtls -0x3000)
# 自定义证书是"追加进默认 bundle"(不是替换), 只塞中间证书即可; 根证书已在默认 bundle
CONFIG_MBEDTLS_CUSTOM_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CUSTOM_CERTIFICATE_BUNDLE_PATH="certs/ca_chain.pem"
# TLS 握手缓冲: 曾降到8192省内存, 但和4KB websocket栈叠加出栈溢出/截断类乱码错误, 恢复16384
CONFIG_MBEDTLS_SSL_IN_CONTENT_LEN=16384
# mbedtls 分配改到 PSRAM: 内部堆被 OPUS 编解码器上下文吃紧, SSL 缓冲(16KB)分配失败(mbedtls_ssl_setup -0x7F00 ALLOC_FAILED)
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
